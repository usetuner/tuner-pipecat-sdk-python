# Required — STT + TTS (one key for both)
SPEECHMATICS_API_KEY=
# STT engine: "agent" = Agent STT preview (linden-1, /v2/agent endpoint),
#             "rt"    = standard real-time API (enhanced, eu2 endpoint)
SPEECHMATICS_STT_MODE=agent

# Optional overrides — leave blank to use the mode's defaults.
# Comments must stay on their own lines: python-dotenv does NOT strip a
# trailing "# ..." here, it reads it as the value.
# Endpoint override (e.g. a different region)
SPEECHMATICS_RT_URL=
# Model override (agent mode default: linden-1; rt mode sends none)
SPEECHMATICS_STT_MODEL=
# TTS voice (default: sarah)
SPEECHMATICS_VOICE=
# TTS endpoint (default: https://preview.tts.speechmatics.com)
SPEECHMATICS_TTS_URL=

# LLM
OPENAI_API_KEY=

# Tuner Observability
TUNER_API_KEY=
TUNER_WORKSPACE_ID=
TUNER_AGENT_ID=pizza-order-bot-speechmatics
# Deployment version number — must be an integer.
# Leave blank to fall back to APP_VERSION or a CI build number.
TUNER_AGENT_VERSION=1
TUNER_BASE_URL=https://api.usetuner.ai
